{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminae",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [{ "pattern": "luminae.lastivka.dev", "custom_domain": true }],
  "preview_urls": false,
  // Wrangler's bundler otherwise wraps functions in `__name(...)`, and next-themes sends one
  // of them to the browser as an inline script, where `__name` does not exist (the theme
  // script then fails and the page flashes the wrong theme).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by the OpenNext adapter.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luminae"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (`npx wrangler secret put NAME --name luminae`): DATABASE_URL, SESSION_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GROQ_API_KEY, VAPID_PRIVATE_KEY, CRON_SECRET
  // (optional: VAPID_SUBJECT, CORVUS_MODEL). Leave GOOGLE_REDIRECT_URI unset so the Google
  // callback follows the address the request came in on.
  // No cron triggers: the scheduled pushes run from Vercel (vercel.json), and running them
  // here as well would send every notification twice.
}
